    {
      "name": "Manufacturers",
      "item": [
        {
          "name": "Get Manufacturers",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Request succeeds\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const response = pm.response.json();",
                  "const manufacturers = response.items || [];",
                  "const guinness = manufacturers.find(item => item.name && item.name.toLowerCase().includes(\"guinness\"));",
                  "const heineken = manufacturers.find(item => item.name && item.name.toLowerCase().includes(\"heineken\"));",
                  "",
                  "if (guinness) {",
                  "    pm.environment.set(\"guinnessManufacturerId\", guinness.id);",
                  "}",
                  "if (heineken) {",
                  "    pm.environment.set(\"heinekenManufacturerId\", heineken.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/manufacturers?page=0&size=100&sort=name,asc",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "manufacturers"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "0"
                },
                {
                  "key": "size",
                  "value": "100"
                },
                {
                  "key": "sort",
                  "value": "name,asc"
                }
              ]
            }
          }
        },
